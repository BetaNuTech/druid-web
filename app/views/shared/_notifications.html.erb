<div id="notifications">
  <div class="row">
    <div class="col-md-12 text-center">
      <% if notice.present? %>
        <p class="notice bg-warning"><%= notice %></p>
      <% end %>
      <%# A view that shows the alert itself, beside the control it is about,
          sets content_for :flash_alert_rendered so it isn't shown twice. %>
      <% if alert.present? && !content_for?(:flash_alert_rendered) %>
        <p class="alert bg-danger"><%= alert %></p>
      <% end %>
    </div>
  </div>
</div>
