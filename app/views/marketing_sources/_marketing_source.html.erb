<div id="<%=marketing_source.id%>" class="well card card--well card--small">
  <% unless marketing_source.active? %>
    <p class="bg-danger">
      INACTIVE
    </p>
  <% end %>

  <% if marketing_source.property_main_line_missing? %>
    <p class="bg-danger">
      <%= glyph('warning-sign') %>
      <b>Property main line missing:</b>
      a tracking number is set, but
      <%= marketing_source.property&.name %> has no main line phone number.
      Calls to this tracking number are routed using the property main line as
      the fallback destination, so they cannot be forwarded or attributed
      until it is set.
      <% if policy(marketing_source.property).edit? %>
        <%= link_to('Set the main line', edit_property_path(marketing_source.property)) %>.
      <% end %>
    </p>
  <% end %>

  <% if marketing_source.yardi_source_missing? %>
    <p class="bg-danger">
      <%= glyph('warning-sign') %>
      <b>Yardi source mismatch:</b>
      a tracking number is set, but Yardi has no marketing source named exactly
      &ldquo;<%= marketing_source.name %>&rdquo; for this property.
      Phone leads will fall back to the &ldquo;Bluesky&rdquo; source in Voyager.
      <small>(checked <%= marketing_source.yardi_source_checked_at&.strftime('%m/%d/%Y %l:%M%P') %>)</small>
    </p>
  <% end %>

  <div class="row">
    <div class="col-md-12">
      <h3>
        <%= marketing_source.name %>
        <small> for <%= marketing_source.property&.name %> </small>
        <%= link_to('Edit', edit_marketing_source_path(marketing_source), class: "btn btn--xs btn--primary") %>
      </h3>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <blockquote>
        <i><%= marketing_source.description %></i>
      </blockquote>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <p>
        <b>Active Dates:</b>
        <span style="white-space: nowrap;">
          <%= marketing_source.start_date %> &#8594; <%= marketing_source.end_date || '(Renewing)' %>
        </span>
        <br/>
        <b>Fees:</b>
        <%= number_to_currency(marketing_source.fee_rate || 0.0) %> / <%= marketing_source.fee_type %><br/>
      </p>
     </div>
    <div class="col-md-6">
      <p>
        <% if marketing_source.tracking_email.present? %>
          <%= glyph(:email) %> <%= marketing_source.tracking_email %><br/>
        <% else %>
          <i>No email tracking</i><br/>
        <% end %>

        <% if marketing_source.tracking_number.present? %>
          <span style="white-space: nowrap;">
            <%= glyph(:phone) %> <%= marketing_source.tracking_number %> &#8594;
            <%= marketing_source.destination_number %>
          </span>
        <% else %>
          <i>No call tracking</i><br/>
        <% end %>
      </p>
     </div>
  </div>

  <div class="row">
    <div class="col-md-6 col-xs-6">
      <table class="marketing-source__stats-table">
        <tbody>
          <tr>
            <td>Total Spend:</td>
            <td> <%= number_to_currency(marketing_source.total_spend) %></td>
          </tr>
          <tr>
            <td>Spend YTD:</td>
           <td><%= number_to_currency(marketing_source.total_spend_ytd) %></td>
          </tr>
          <tr>
            <td>Per Lead:</td>
            <td><%= number_to_currency(marketing_source.spend_per_lead) %></td>
          </tr>
          <tr>
            <td>Per Conversion:</td>
           <td><%= number_to_currency(marketing_source.spend_per_conversion) %></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="col-md-6 col-xs-6">
      <table class="marketing-source__stats-table">
        <tbody>
          <tr>
            <td>Total Leads:</td>
            <td><%= marketing_source.total_leads %></td>
          </tr>
          <tr>
            <td>Leads YTD:</td>
           <td><%= marketing_source.total_leads_ytd %></td>
          </tr>
          <tr>
            <td>Conversions:</td>
            <td><%= marketing_source.total_conversions %></td>
          </tr>
          <tr>
            <td>Conversions YTD:</td>
           <td><%= marketing_source.total_conversions_ytd %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <h4>
        Expenses
        <%= link_to('Add', new_marketing_source_marketing_expense_path(marketing_source_id: marketing_source.id), class: "btn btn--xs btn--primary") %>
      </h4>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div class="table-responsive">
        <table class="table table--striped">
          <thead>
            <tr>
              <th>Dates</th>
              <th>Description</th>
              <th>Qty</th>
              <th>Total</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'marketing_expense', collection: marketing_source.marketing_expenses.order('start_date DESC') %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
