<%# The email/password form. Permanent -- it is demoted, never removed -- so this
    partial is rendered in both layouts of users/sessions/new: as the primary
    form when Google sign-in is off, and inside the collapsed disclosure when it
    is on. %>
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth__password-form' }) do |f| %>
  <div class="form__group">
    <%= f.label :email, class: "form__label" %>
    <%= f.email_field :email, { autofocus: autofocus, class: "form__control", placeholder: "Enter your email address" } %>
  </div>

  <div class="form__group">
    <%= f.label :password, class: "form__label" %>
    <%= f.password_field :password, { autocomplete: "off", class: "form__control", placeholder: "Enter your password" } %>
  </div>

  <% if devise_mapping.rememberable? -%>
    <div class="form__group">
      <div class="form__check">
        <%= f.check_box :remember_me, class: "form__check-input" %>
        <%= f.label :remember_me, class: "form__check-label" %>
      </div>
    </div>
  <% end -%>

  <div class="form__group">
    <button type="submit" class="btn btn--primary btn--block btn--lg">Log In</button>
  </div>
<% end %>

<%# Recovery links -- forgot password, resend confirmation, resend unlock --
    live inside this partial on purpose, so they travel with the password form
    and sit INSIDE the disclosure when Google sign-in is on. They only mean
    anything to someone using the password path. %>
<div class="auth__links text-center">
  <%= render "devise/shared/links" %>
</div>
