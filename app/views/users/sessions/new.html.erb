<div class="auth-page">
  <div class="auth-container">
    <div class="card card--auth">
      <div class="card__body">
          <h2 class="auth__title text-center">Log in to BlueSky</h2>
          <%# Says what BlueSky is: for anyone not signed in this page is the
              homepage, and Google's consent-screen review expects the homepage
              to explain the app's purpose. %>
          <p class="auth__subtitle text-center text-muted">Bluecore Residential's lead management and leasing system.</p>

          <% if flash[:alert] %>
            <%# Shown here, above the sign-in controls, instead of in the
                layout's notifications bar -- see shared/_notifications. %>
            <% content_for :flash_alert_rendered, 'true' %>
            <div class="alert alert-danger">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <% if GoogleSignIn.enabled? %>
            <div class="auth__google">
              <%#
                MUST be a button_to (POST), never a link_to. OmniAuth 2.x refuses
                GET request-phase initiation, so a link would 404. The
                omniauth-rails_csrf_protection gem checks this POST's
                authenticity token.

                The named route rather than Devise's omniauth_authorize_path
                helper: Devise only mixes that helper in when a strategy was
                registered at boot, so it would not exist whenever the page
                is rendered with the toggle stubbed on (specs) or off at boot.
              %>
              <%= button_to user_google_oauth2_omniauth_authorize_path,
                            method: :post,
                            class: "btn btn--google btn--block btn--lg",
                            form_class: "auth__google-form",
                            data: { turbolinks: false } do %>
                <span class="btn--google__mark" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
                    <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
                    <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
                  </svg>
                </span>
                <span>Sign in with Google</span>
              <% end %>
              <p class="auth__hint text-center">Use the Google account that matches your work email address.</p>
            </div>

            <%# Collapsed by default; see SignInHelper#password_disclosure_open?
                for exactly when it starts open. %>
            <details class="auth__disclosure"<%= ' open' if password_disclosure_open? %>>
              <summary class="auth__disclosure-summary">Sign in with an email address and password instead</summary>
              <div class="auth__disclosure-body">
                <%= render "users/sessions/password_form", autofocus: false %>
              </div>
            </details>
          <% else %>
            <%# Google sign-in is off: the password-first layout, unchanged. %>
            <%= render "users/sessions/password_form", autofocus: true %>
          <% end %>
      </div>
    </div>
  </div>
</div>
