<%= form_with(model: property, local: true, html: { multipart: true }) do |form| %>
  <% if property.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(property.errors.count, "error") %> prohibited this property from being saved:</h2>

      <ul>
        <% property.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if property.persisted? && property.main_line_missing? %>
    <div class="alert alert--danger" role="alert">
      <%= glyph('warning-sign') %>
      <b>Main line phone number is not set.</b>
      The main line (the <i>Phone</i> field under Contact Information) is how
      incoming calls are resolved to this property, and it is the fallback
      destination whenever the leasing or maintenance number is blank.
      <% if property.marketing_tracking_numbers_without_main_line? %>
        This property already has marketing tracking numbers, so calls to them
        cannot be forwarded and phone leads cannot be attributed until the main
        line is set.
      <% else %>
        Marketing tracking numbers added for this property will not be able to
        forward calls or attribute phone leads until it is set.
      <% end %>
    </div>
  <% end %>

  <%= render partial: 'form_general', locals: {form: form, property: property} %>
  <%= render partial: 'form_office_hours', locals: {form: form, property: property} %>
  <%= render partial: 'form_contact', locals: {form: form, property: property} %>
  <%#= render partial: 'form_marketing_numbers', locals: {form: form, property: property} %>
  <%= render partial: 'form_other', locals: {form: form, property: property} %>
  <%= render partial: 'form_listings', locals: {form: form, property: property} %>
  <%= render partial: 'form_employees', locals: {form: form, property: property} %>
  <%= render partial: 'form_preferences', locals: {form: form, property: property} %>


  <div class="row">
    <div class="col-md-12 form__group">
      <br/>
      <button type="submit" class="btn btn--primary">Save</button>
      <%= link_to('Cancel', :back, class: "btn btn--xs btn--info") %>
    </div>
  </div>
<% end %>
